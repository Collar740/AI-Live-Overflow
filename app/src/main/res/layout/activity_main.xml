<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FAFAFA">
    <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="桌宠未启动" android:textSize="18sp" android:layout_marginBottom="24dp"/>
    <Button android:id="@+id/startBtn" android:layout_width="200dp" android:layout_height="48dp" android:text="启动桌宠" android:layout_marginBottom="12dp"/>
    <Button android:id="@+id/stopBtn" android:layout_width="200dp" android:layout_height="48dp" android:text="停止桌宠" android:backgroundTint="#CCCCCC"/>
</LinearLayout>
